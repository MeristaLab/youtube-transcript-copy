{
  "manifest_version": 3,
  "name": "YouTube 文字起こしコピー",
  "version": "0.3.0",
  "description": "YouTubeの文字起こしパネルから全文をコピーします。",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}